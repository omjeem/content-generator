# ─────────────────────────────────────────────────────────────────────────────
# .env.docker.example — Docker deployment environment variables
#
# USAGE:
#   cp .env.docker.example .env
#   # Fill in all required values
#   docker compose up --build
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED — API Server ─────────────────────────────────────────────────────

# MongoDB connection string (Atlas, self-hosted, or Docker)
# Atlas example:  mongodb+srv://username:password@cluster0.xxxxx.mongodb.net/content-generator
# Local Docker:   mongodb://mongo:27017/content-generator
MONGODB_URI=

# JWT signing secret — use a long random string (min 32 chars)
# Generate one: openssl rand -base64 32
JWT_SECRET=

# Google Gemini API key (from https://aistudio.google.com/app/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=

# ── REQUIRED — Frontend ───────────────────────────────────────────────────────

# The URL your BROWSER will use to reach the API.
# This is baked into the Next.js bundle at BUILD TIME — not a runtime variable.
# ⚠️  Use your server's external IP or domain, NOT Docker internal names like 'api'.
#
# Same-server deployment: http://YOUR_SERVER_IP:3001
# With domain + reverse proxy: https://api.yourdomain.com
# Local development: http://localhost:3001
NEXT_PUBLIC_API_URL=http://localhost:3001

# ── OPTIONAL ─────────────────────────────────────────────────────────────────

# Tavily API key for enhanced trend research (optional, Gemini is used as fallback)
TAVILY_API_KEY=

# API server port (default: 3001)
PORT=3001

# ── Docker Hub (for docker-compose.prod.yml) ──────────────────────────────────

# Your Docker Hub username (used to pull images in production)
DOCKERHUB_USERNAME=your-dockerhub-username

# Image tag to pull (default: latest)
# Use a specific sha-XXXXXXX tag for pinned deployments
IMAGE_TAG=latest
