# ============================================================
# LinkedIn AI Content Suggestion Agent — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# ── LLM PROVIDER ─────────────────────────────────────────────────────────────
# Choose which model provider powers ALL agents. Switching providers is a pure
# config change — set this one variable, fill in the matching key/model below,
# and restart. No code changes needed.
#   gemini → Google Gemini (default)
#   ollama → Ollama Cloud (or a self-hosted Ollama server)
MODEL_PROVIDER=gemini

# ── GEMINI (used when MODEL_PROVIDER=gemini) ─────────────────────────────────
# GEMINI API KEY
# Get free at: https://ai.google.dev
# Click "Get API key" → Create API key → No credit card required
# Free tier: 15 RPM, 1M tokens/day for gemini-2.5-flash
GEMINI_API_KEY=
# Model name to use. Default: gemini-2.5-flash
GEMINI_MODEL=gemini-2.5-flash

# ── OLLAMA (used when MODEL_PROVIDER=ollama) ─────────────────────────────────
# Ollama exposes an OpenAI-compatible API, so the same code path works for both
# Ollama Cloud and a local server.
#
# Ollama Cloud:  https://ollama.com/settings/keys to create an API key
#   OLLAMA_BASE_URL=https://ollama.com/v1   (default)
#   OLLAMA_API_KEY=<your key>
#   OLLAMA_MODEL=gpt-oss:120b   (or any model available on your account)
#
# Local server (no key required):
#   OLLAMA_BASE_URL=http://localhost:11434/v1
#   OLLAMA_MODEL=llama3.1
OLLAMA_API_KEY=
OLLAMA_BASE_URL=https://ollama.com/v1
OLLAMA_MODEL=gpt-oss:120b

# Reasoning budget for reasoning models (gpt-oss, deepseek-r1, qwq...).
# The agents do extraction/formatting work, so "low" is both faster and just as
# accurate — most of the latency on these models is the hidden reasoning pass.
#   low (default) | medium | high | default (send nothing, let the model decide)
OLLAMA_REASONING_EFFORT=low

# ── STRUCTURED OUTPUT (applies to every provider) ────────────────────────────
# How JSON responses are enforced. No response schema is ever sent to the model —
# see the "How structured (JSON) output is enforced" section in README.md.
#
# on (default) → JSON calls use the provider's native JSON mode
#                (Ollama response_format=json_object / Gemini responseMimeType),
#                which makes malformed JSON — and the repair call it costs —
#                effectively impossible.
# off          → prompt-level JSON only; the local parser + repair pass handles it.
# Set to "off" only if your model/endpoint rejects the flag (the app also
# disables it automatically for the process on the first such rejection).
LLM_JSON_MODE=on

# Allow ONE model-driven repair call when local parsing/validation fails.
# "off" never spends a second call — the pipeline retries or falls back instead.
LLM_JSON_REPAIR=on

# Multiplier applied to every pipeline step timeout. Large/self-hosted models are
# far slower than a hosted flash model, so this defaults to 3 for ollama and 1
# for gemini. Set only to override.
# LLM_TIMEOUT_SCALE=3

# MONGODB CONNECTION URI
# Get free at: https://cloud.mongodb.com
# Create account → New Project → Build Database → M0 Free (512MB)
# Connect → Drivers → Copy connection string
# Replace <password> with your DB user password
MONGODB_URI=

# JWT SECRET
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters long
JWT_SECRET=

# TAVILY API KEY (Optional but recommended — premium trend source)
# Get free at: https://tavily.com
# Sign up → Dashboard → API Keys → Create API key
# Free tier: 1000 searches/month (1 credit per search)
#
# Without this key: trends come from Hacker News Algolia + RSS feeds (free, no key needed)
# With this key:    trends additionally include real-time web search results (higher quality)
TAVILY_API_KEY=

# ── PORTS & URLS (single source of truth) ────────────────────────────────────
# Change these two values to move the stack to different ports.
# Everything else (CORS, Swagger, Next.js fetch) reads from here — nothing
# is hardcoded elsewhere in the codebase.

# BACKEND PORT
# The port the Express API server will listen on.
# Default: 5006 (Next.js uses 3000, so we use 5006 to avoid conflicts)
PORT=5006

# FRONTEND URL
# The origin the Next.js frontend is served from.
# Used by the API for CORS — must match the port Next.js runs on.
# Default: http://localhost:3000 (Next.js dev server default)
FRONTEND_URL=http://localhost:3000

# NEXT.JS PUBLIC API URL
# The full URL the browser uses to reach the backend API.
# Must match PORT above.  Also set in apps/web/.env.local (keep in sync).
# For local development: http://localhost:${PORT}
# For production: your deployed API URL (e.g., https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:5006
