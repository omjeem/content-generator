# ============================================================
# LinkedIn AI Content Suggestion Agent — Environment Variables
# Copy this file to .env and fill in your values
# ============================================================

# GEMINI API KEY
# Get free at: https://ai.google.dev
# Click "Get API key" → Create API key → No credit card required
# Free tier: 15 RPM, 1M tokens/day for gemini-1.5-flash
GEMINI_API_KEY=

# MONGODB CONNECTION URI
# Get free at: https://cloud.mongodb.com
# Create account → New Project → Build Database → M0 Free (512MB)
# Connect → Drivers → Copy connection string
# Replace <password> with your DB user password
MONGODB_URI=

# JWT SECRET
# Generate your own with:
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Must be at least 32 characters long
JWT_SECRET=

# TAVILY API KEY (Optional — used as fallback for trend research)
# Get free at: https://tavily.com
# Sign up → Dashboard → API Keys → Create API key
# Free tier: 1000 searches/month
TAVILY_API_KEY=

# BACKEND PORT
# The port the Hono API server will listen on
# Default: 3001 (Next.js uses 3000, so we use 3001 to avoid conflicts)
PORT=3001

# NEXT.JS PUBLIC API URL
# The URL the frontend uses to reach the backend
# For local development: http://localhost:3001
# For production: your deployed API URL (e.g., https://api.yourdomain.com)
NEXT_PUBLIC_API_URL=http://localhost:3001
